{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kolaria Documentation",
  "colors": {
    "primary": "#0E8A96",
    "light": "#24D4DF",
    "dark": "#1CC7D2"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "overview",
              "quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/how-it-works",
              "concepts/content-pipeline",
              "concepts/brand-voice"
            ]
          },
          {
            "group": "GEO",
            "pages": [
              "geo/overview",
              "geo/prompts-and-competitors",
              "geo/traffic",
              "geo/agent-readiness",
              "geo/content-gaps-and-writer"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/github",
              "integrations/linear",
              "integrations/slack",
              "integrations/granola",
              "integrations/google-search-console",
              "integrations/framer",
              "integrations/featul",
              "integrations/kontentspace"
            ]
          },
          {
            "group": "Developer Tools",
            "pages": [
              "devtools/cli",
              "devtools/mcp",
              "devtools/raycast"
            ]
          },
          {
            "group": "Automation",
            "pages": [
              "automation/overview",
              "automation/event-based",
              "automation/scheduled"
            ]
          },
          {
            "group": "Content Types",
            "pages": [
              "content/blog-posts",
              "content/changelogs",
              "content/social-media"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "organization/workspace-setup",
              "organization/team-management",
              "organization/billing"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api/getting-started",
              "api/authentication",
              "api/rate-limits"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "api/rust-sdk",
              "api/caching",
              "api/common-tasks",
              "api/types",
              "api/pagination",
              "api/agent-feedback"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api/webhooks/overview",
              "api/webhooks/events"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "assistant",
      "mcp",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "description": "Documentation for Kolaria: track your brand across AI answer engines and turn your team's work into content.",
  "api": {
    "url": "full"
  },
  "background": {
    "decoration": "windows"
  },
  "search": {
    "prompt": "Search the Kolaria docs..."
  },
  "seo": {
    "metatags": {
      "twitter:site": "@kolaria"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/overview"
    },
    {
      "source": "/api",
      "destination": "/api/getting-started"
    },
    {
      "source": "/api-reference/openapi.json",
      "destination": "https://api.kolaria.com/openapi.json",
      "permanent": false
    },
    {
      "source": "/sdk/getting-started",
      "destination": "/api/getting-started"
    },
    {
      "source": "/integrations/mcp",
      "destination": "/devtools/mcp"
    }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "This page is on a content pipeline of its own",
      "description": "Looks like this page hasn't shipped yet. Try the [quickstart](/quickstart) or head back to the [overview](/overview)."
    }
  },
  "metadata": {
    "timestamp": true
  }
}
